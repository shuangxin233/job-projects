# 使用智谱免费模型：登录 https://bigmodel.cn 在控制台创建 API 密钥。
# 复制为 .env 后填入自己的智谱 Key，不需要购买 Coding Plan。
LLM_API_KEY=
LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
LLM_MODEL=glm-4-flash-250414
# 免费 API 连续请求主动间隔 10 秒，0～30 可调。
LLM_MIN_INTERVAL_SECONDS=10
# 免费额度有限，达到限额后等待恢复；程序不会自动切换付费 API。
# 其他服务需要该服务自己的密钥，不能混用。
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=qwen/qwen3.8-27b
# LLM_BASE_URL=https://api.deepseek.com
# LLM_MODEL=deepseek-v4-flash
# OpenAI 或其他兼容 Chat Completions/function calling 的服务也可配置。
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=填写你账号可用且支持 Chat Completions 工具调用的模型
